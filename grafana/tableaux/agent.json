  {
   "id": 8,
   "type": "timeseries",
   "title": "Gain / perte par stratégie ($)",
   "description": "",
   "datasource": {
    "type": "frser-sqlite-datasource",
    "uid": "agent-sqlite"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 16,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "frser-sqlite-datasource",
      "uid": "agent-sqlite"
     },
     "queryType": "table",
     "rawQueryText": "SELECT CAST(ts / MAX(5, ($__to - $__from) / 600000) AS INTEGER) * MAX(5, ($__to - $__from) / 600000) AS time, MAX(CASE WHEN strategie = 'scalping' THEN valeur - depart END) AS \"Scalping\", MAX(CASE WHEN strategie = 'tendance' THEN valeur - depart END) AS \"Tendance\", MAX(CASE WHEN strategie = 'financement' THEN valeur - depart END) AS \"Financement\", MAX(CASE WHEN strategie = 'total' THEN valeur - depart END) AS \"Total\" FROM valeurs WHERE ts >= $__from / 1000 AND ts <= $__to / 1000 GROUP BY 1 ORDER BY 1",
     "queryText": "SELECT CAST(ts / MAX(5, ($__to - $__from) / 600000) AS INTEGER) * MAX(5, ($__to - $__from) / 600000) AS time, MAX(CASE WHEN strategie = 'scalping' THEN valeur - depart END) AS \"Scalping\", MAX(CASE WHEN strategie = 'tendance' THEN valeur - depart END) AS \"Tendance\", MAX(CASE WHEN strategie = 'financement' THEN valeur - depart END) AS \"Financement\", MAX(CASE WHEN strategie = 'total' THEN valeur - depart END) AS \"Total\" FROM valeurs WHERE ts >= $__from / 1000 AND ts <= $__to / 1000 GROUP BY 1 ORDER BY 1",
     "timeColumns": [
      "time"
     ]
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "unit": "currencyUSD",
     "decimals": 2,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "spanNulls": true
     }
    },
